# --- LLM -------------------------------------------------------------------
# mock | openai | yandex | gigachat
LLM_PROVIDER=mock
LLM_API_KEY=
# OpenAI-compatible endpoint (DeepSeek example)
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
# YandexGPT only
LLM_FOLDER_ID=
# GigaChat only. LLM_API_KEY is the authorization key from the GigaChat console.
GIGACHAT_BASE_URL=https://api.giga.chat/v1
GIGACHAT_MODEL=GigaChat
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_CA_BUNDLE=
LLM_TIMEOUT_SECONDS=40
LLM_MAX_RETRIES=2

# --- Security --------------------------------------------------------------
# Leave empty for local development. Set for a public demo.
WEBHOOK_SECRET=change-me
DASHBOARD_USER=hr
DASHBOARD_PASSWORD=

# --- Application -----------------------------------------------------------
# Local default. Docker Compose overrides with PostgreSQL.
DATABASE_URL=sqlite:///./data/app.db
SEED_ON_STARTUP=false
SEED_ANALYZE=true
ANALYZE_IN_BACKGROUND=true

# --- Docker / Caddy ---------------------------------------------------------
# Use http://localhost for local HTTP, or demo.example.ru for automatic HTTPS.
DOMAIN=http://localhost
POSTGRES_PASSWORD=mgts
