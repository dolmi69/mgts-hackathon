# --- LLM -------------------------------------------------------------------
# mock | gigachat | yandex | openai
# For real data use gigachat or yandex: comments stay in Russia (152-FZ).
LLM_PROVIDER=mock
LLM_API_KEY=
# OpenAI-compatible endpoint. A foreign host (DeepSeek, OpenAI) is refused in
# pilot/production unless LLM_ALLOW_CROSS_BORDER=true (requires notifying Roskomnadzor).
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_ALLOW_CROSS_BORDER=false
# Before a comment goes to the LLM, also find names outside the roster with
# Natasha NER (~190 MB RAM, ~1 s on first use). false = regexes and roster only.
ANONYMIZER_NER=true
# YandexGPT only
LLM_FOLDER_ID=
# GigaChat only. LLM_API_KEY is the authorization key from the GigaChat console.
GIGACHAT_BASE_URL=https://api.giga.chat/v1
GIGACHAT_MODEL=GigaChat
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_CA_BUNDLE=
LLM_TIMEOUT_SECONDS=40
LLM_MAX_RETRIES=2

# --- Security (REQUIRED for Docker) ------------------------------------------
# Docker Compose refuses to start until these are set. Generate values with:
#   openssl rand -hex 24
# Outside APP_ENV=dev the API also refuses weak values: password >= 12
# characters, webhook secret >= 16 characters. Send the secret only in the
# X-Webhook-Secret header (query strings end up in access logs).
WEBHOOK_SECRET=
YANDEX_FORMS_FIELDS={}
# Webhook with an intern ID missing from the roster: create | hold.
# Empty = create in dev/demo, hold (park for manual mapping) in pilot/production.
WEBHOOK_UNKNOWN_INTERNS=
DASHBOARD_USER=hr
DASHBOARD_PASSWORD=
DASHBOARD_VIEWER_USER=
DASHBOARD_VIEWER_PASSWORD=

# --- Application -----------------------------------------------------------
# Local default. Docker Compose overrides with PostgreSQL.
DATABASE_URL=sqlite:///./data/app.db
# dev: local only; without a password the API answers only to 127.0.0.1.
# demo: public demo, seed data allowed. pilot/production: real data only.
APP_ENV=demo
SEED_ON_STARTUP=false
SEED_ANALYZE=true
# ANALYZE_IN_BACKGROUND: leave unset. Docker uses the worker, a local run the API itself.
DEMO_FEEDBACK_ENABLED=false

# --- Docker / Caddy ---------------------------------------------------------
# Use http://localhost for local HTTP, or demo.example.ru for automatic HTTPS.
DOMAIN=http://localhost
POSTGRES_PASSWORD=
